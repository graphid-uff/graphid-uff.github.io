<a href="{{ publicacao.url | relative_url }}" class="publication-card-link">
  <div class="card hoverable publication-card">
    {% if publicacao.img %}
      <div class="publication-card-img">
        {%
          include figure.liquid
          loading="eager"
          path=publicacao.img
          sizes = "250px"
          alt="publication thumbnail"
          class="img-fluid"
        %}
      </div>
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">{% include i18n.liquid pt=publicacao.title en=publicacao.title_en %}</h2>
      <p class="card-text">{% include i18n.liquid pt=publicacao.description en=publicacao.description_en %}</p>
    </div>
  </div>
</a>
