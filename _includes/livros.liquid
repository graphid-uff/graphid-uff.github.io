<a href="{{ livro.url | relative_url }}" class="publication-card-link">
  <div class="card hoverable publication-card">
    {% if livro.img %}
      <div class="publication-card-img">
        {%
          include figure.liquid
          loading="eager"
          path=livro.img
          sizes = "250px"
          alt="book cover"
          class="img-fluid"
        %}
      </div>
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">{% include i18n.liquid pt=livro.title en=livro.title_en %}</h2>
      <p class="card-text">{% include i18n.liquid pt=livro.description en=livro.description_en %}</p>
    </div>
  </div>
</a>
