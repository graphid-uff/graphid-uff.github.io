{% capture footer_contents %}
  <span class="footer-social">
    <a href="https://www.instagram.com/graphid.uff/" target="_blank" rel="noopener noreferrer" title="Instagram">
      <i class="fa-brands fa-instagram"></i>
      <span class="footer-instagram-handle">@graphid.uff</span>
    </a>
    <a href="https://www.uff.br" target="_blank" rel="noopener noreferrer" title="UFF">
      <img src="{{ '/assets/img/logouff_horizontal_azul_fundo_transparente-1.png' | relative_url }}" alt="UFF" class="footer-uff-logo">
    </a>
  </span>
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
